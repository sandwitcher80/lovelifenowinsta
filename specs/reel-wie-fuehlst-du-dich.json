{"name": "2026-12-17-wie-fuehlst-du-dich", "start": 102, "scenes": [{"type": "text", "text": "Wie fühlst du dich gerade?", "accent": "gerade", "secs": 3, "pal": "NV", "fs": 104}, {"type": "text", "text": "Wenn die Antwort „gut“ ist: halte kurz inne.", "secs": 4, "pal": "BS", "fs": 82}, {"type": "text", "text": "Wo im Körper spürst du dieses „gut“?", "secs": 4, "pal": "BL", "fs": 82}, {"type": "text", "text": "Atme einmal lang aus und spür nach.", "secs": 3.5, "pal": "NV", "fs": 84}, {"type": "breath", "in": 4, "out": 6, "cycles": 2, "pal": "BS"}, {"type": "text", "text": "Und wenn die Antwort „nicht so gut“ ist?", "secs": 3.5, "pal": "BL", "fs": 82}, {"type": "text", "text": "Dann halte auch kurz inne. Beides darf da sein.", "secs": 4.5, "pal": "NV", "fs": 80}, {"type": "end", "text": "Speichern für später.", "pal": "BS", "secs": 3.5, "fs": 96}]}